# ===========================================================================
# Multilingual file for the TOS 7 Docker application "documensodocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Documenso"
auth         = "Documenso"
version      = "@@VERSION@@"
descript     = "Documenso is a self-hosted document signing platform: upload a PDF, add fields, send it for signature and keep an audit trail, an open alternative to DocuSign. This package runs the upstream image (mirrored to Docker Hub by the maintainer) with its own PostgreSQL database as non-root containers. Only the x86_64 package is built because the mirrored image is amd64."
release_note = "1. First release."
important    = "Open the web UI on port 8155 and sign up for the first account (the first user becomes admin), then create a document and send it. The stack contains two containers (app, PostgreSQL); the NextAuth secret is generated on first start. Data lives under /Volume1/DockerAppData/documensodocker/. Sending real emails needs SMTP settings, otherwise use the in-app links. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "Documenso"
auth         = "Documenso"
version      = "@@VERSION@@"
descript     = "习惯打卡与连续天数统计，界面简洁。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/beaverhabitsdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

