# ===========================================================================
# Multilingual file for the TOS 7 Docker application "documensodocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Documenso"
auth         = "Documenso"
version      = "@@VERSION@@"
descript     = "Documenso is a self-hosted document signing platform: upload a PDF, add fields, send it for signature and keep an audit trail, an open alternative to DocuSign. This package runs the official Docker Hub image (documenso/documenso) with its own PostgreSQL database; both containers run as non-root users. Only the x86_64 package is built because the upstream image is amd64."
release_note = "1. Official Docker Hub image documenso/documenso:v2.22.0 (digest sha256:f9976d21…), replacing the previous personal mirror. 2. Telemetry is disabled by default. 3. Persistent data-encryption keys and a self-signed signing certificate are generated on first start, so signing works out of the box and background jobs no longer report a missing encryption key. 4. Privacy policy, licence notices and third-party API disclosure added. 5. Chinese descriptions corrected."
important    = "Open the web UI on port 8155 and sign up for the first account (first user is admin), then create a document and send it. Two containers (app, PostgreSQL); the NextAuth secret, encryption keys and a self-signed signing certificate are generated on first start. Data lives under /Volume1/DockerAppData/documensodocker/. Sending real e-mail needs SMTP, otherwise use the in-app links. Back up the data folder before uninstalling with data removal. Plain HTTP; privacy policy: https://www.moechz.com/privacy.html"

[zh-cn]
name         = "Documenso"
auth         = "Documenso"
version      = "@@VERSION@@"
descript     = "Documenso 是自托管的电子签名平台：上传 PDF、添加签名字段、发送给对方签署并保留审计记录，是 DocuSign 的开源替代。本应用使用 Docker Hub 官方镜像 documenso/documenso，并自带 PostgreSQL 数据库，两个容器都以非 root 用户运行。目前仅提供 x86_64 架构。"
release_note = "1. 改用 Docker Hub 官方镜像 documenso/documenso:v2.22.0（摘要 sha256:f9976d21…）。2. 默认关闭遥测。3. 首次启动自动生成数据加密密钥与自签名签名证书，签名开箱可用，后台任务不再报缺少加密密钥。4. 新增隐私政策、许可声明与第三方 API 说明。5. 修正中文文案。"
important    = "在浏览器打开 8155 端口的界面并注册第一个账号（首个用户即管理员），然后新建文档并发送。应用由两个容器组成（应用 + PostgreSQL）；首次启动会自动生成 NextAuth 密钥、数据加密密钥和自签名签名证书。数据保存在 /Volume1/DockerAppData/documensodocker/。真实发信需在应用内配置 SMTP，否则使用站内链接。卸载并勾选删除数据前请先备份该目录。局域网内为 HTTP；隐私政策：https://www.moechz.com/privacy.html"

[zh-hk]
name         = "Documenso"
auth         = "Documenso"
version      = "@@VERSION@@"
descript     = "Documenso 是自託管的電子簽名平台：上傳 PDF、加入簽名字段、傳送給對方簽署並保留稽核記錄，是 DocuSign 的開源替代。本應用使用 Docker Hub 官方映像 documenso/documenso，並內建 PostgreSQL 資料庫，兩個容器都以非 root 使用者執行。目前僅提供 x86_64 架構。"
release_note = "1. 改用 Docker Hub 官方映像 documenso/documenso:v2.22.0（摘要 sha256:f9976d21…）。2. 預設關閉遙測。3. 首次啟動自動產生資料加密金鑰與自簽名簽章憑證，簽名開箱可用，背景工作不再回報缺少加密金鑰。4. 新增隱私政策、授權聲明與第三方 API 說明。5. 修正中文文案。"
important    = "在瀏覽器開啟 8155 埠的介面並註冊第一個帳號（首位使用者即管理員），然後新增文件並傳送。應用由兩個容器組成（應用 + PostgreSQL）；首次啟動會自動產生 NextAuth 金鑰、資料加密金鑰與自簽名簽章憑證。資料儲存在 /Volume1/DockerAppData/documensodocker/。實際寄信需在應用內設定 SMTP，否則使用站內連結。解除安裝並勾選刪除資料前請先備份該目錄。區域網路內為 HTTP；隱私政策：https://www.moechz.com/privacy.html"

